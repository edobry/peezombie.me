.DS_Store
node_modules/

# The corpus itself is NOT committed. data/ is the principal's own Twitter export;
# it is reconstructed locally from the archive zip (see README > Provenance), or
# pulled from the Community Archive API. History was purged of it via git-filter-repo
# on 2026-08-27.
data/
twitter-*.zip

# Pipeline intermediates — all regenerable via `npm run build`.
pipeline/tweets.json
pipeline/threads.json
pipeline/thread-links.json
pipeline/concept-index.json
pipeline/garden-data.json
pipeline/tags.json

# Scratch notes, not part of the project.
.notes/

# Minsky project identity (.minsky/config.yaml) IS tracked — it is how this repo
# resolves to its project. config.local.yaml is machine-local (absolute paths,
# per-machine harness) and must not be.
.minsky/config.local.yaml

# Left over from an `init` run predating mt#4715, when the default was
# --rule-format cursor. `init` now compiles for the detected harness, so this repo
# (worked in Claude Code — see mt#4676) no longer generates .cursor/ at all. The
# ignore stays because existing checkouts still carry the old directory.
.cursor/
